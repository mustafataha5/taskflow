
# ==========================================
# TaskFlow - Git Ignore
# FastAPI + SQLModel + SQLite + Angular
# ==========================================


# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python build artifacts
build/
dist/
*.egg-info/
.eggs/

# Python testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/


# ------------------------------------------
# SQLite databases
# ------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3


# ------------------------------------------
# Environment variables and secrets
# ------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key


# ------------------------------------------
# Angular / Node.js
# ------------------------------------------
node_modules/
.angular/
.cache/
.npm/

# Build outputs
dist/
out-tsc/
coverage/

# Temporary files
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------
# IDE / Editors
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.swp
*.swo
*~


# ------------------------------------------
# Operating systems
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini


# ------------------------------------------
# Logs / Temporary files
# ------------------------------------------
*.log
logs/
tmp/
temp/


# ------------------------------------------
# Local tooling
# ------------------------------------------
.pyre/
.pytype/
.ipynb_checkpoints/
